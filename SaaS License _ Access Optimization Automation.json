      "id": "1a19247f-588d-4a6f-83bf-5b4e31bf6e49",
      "name": "Merge License+Usage"
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\n\nreturn items.map(item => {\n  const data = item.json;\n\n  let status;\n  let reason;\n  let inactiveDays = null;\n\n  if (!data.last_activity) {\n    status = \"DATA_CHECK\";\n    reason = \"No usage record available\";\n  } else {\n    const lastActivity = new Date(data.last_activity);\n\n    inactiveDays = Math.floor(\n      (now - lastActivity) / (1000 * 60 * 60 * 24)\n    );\n\n    if (inactiveDays > 60) {\n      status = \"REVIEW\";\n      reason = `Inactive for ${inactiveDays} days`;\n    } else {\n      status = \"KEEP\";\n      reason = `Used within the last ${inactiveDays} days`;\n    }\n  }\n\n  return {\n    json: {\n      ...data,\n      inactive_days: inactiveDays,\n      status,\n      reason\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        -304
      ],
      "id": "25518975-c285-41bd-8dfe-45e321f58129",
      "name": "Evaluate License Usage"
    },
    {
      "parameters": {
        "jsCode": "const rawText = $json.data;\nconst parsed = JSON.parse(rawText);\nreturn parsed.map(item => ({ json: item }));"
      },
